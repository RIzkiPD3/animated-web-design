---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPhotographs, formatTelemetry } from '../data/photos';

const contentEntries = await getCollection('photos');
const localPhotos = getPhotographs();
---

<BaseLayout>
  <main class="viewport-padding py-16 md:py-24 max-w-4xl">
    <header class="space-y-6">
      <div class="text-metadata text-muted">
        ARCHIVE REFERENCE: ATELIER OBSCURA
      </div>
      <h1 class="text-display">
        Spatial Photography Archive
      </h1>
      <p class="text-heading text-muted">
        Archive Data &amp; Photography Model foundation.
      </p>
      <p class="text-body max-w-2xl text-muted">
        Centralized curatorial data collection validating photographic aspect ratios,
        optical EXIF telemetry, and editorial metadata for Exhibition Runway and Deep Monograph.
      </p>
      <div class="pt-4 flex items-center gap-4">
        <a
          href="#archive-manifest"
          class="text-metadata px-4 py-2 border border-muted/40 rounded-sm hover:border-muted text-foreground transition-colors"
        >
          VERIFY ARCHIVE MANIFEST ({contentEntries.length} PLATES)
        </a>
      </div>
    </header>

    <section id="archive-manifest" class="mt-16 pt-8 border-t border-muted/20 space-y-6">
      <div class="space-y-2">
        <h2 class="text-heading">Curatorial Archive Manifest</h2>
        <p class="text-body text-muted">
          All eight archival plates verified via Astro Content Collections and typed data module.
        </p>
      </div>

      <div class="border border-muted/20 rounded-sm divide-y divide-muted/20 overflow-x-auto">
        {localPhotos.map((photo) => (
          <div class="p-4 flex flex-col md:flex-row md:items-center justify-between gap-2 text-metadata">
            <div class="space-y-1">
              <span class="text-accent font-mono">{photo.metadata.plateNumber}</span>
              <span class="text-foreground ml-2 font-serif text-base">{photo.title}</span>
              <span class="text-muted block md:inline md:ml-2">({photo.metadata.series})</span>
            </div>
            <div class="flex items-center gap-4 text-muted">
              <span>{photo.image.aspectRatio} ({photo.image.width}x{photo.image.height})</span>
              <span>{formatTelemetry(photo.metadata)}</span>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

